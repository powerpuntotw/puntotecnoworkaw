# TecnoPrint Agent — Configuración
# Copiar este archivo como .env en la misma carpeta que el .exe

# ── Appwrite ────────────────────────────────────────────────
APPWRITE_ENDPOINT=https://appwrite.tecnowork.mywire.org/v1
APPWRITE_PROJECT_ID=69aed0bd000df45ebd3a
APPWRITE_API_KEY=standard_6655b4758f6786529a0611f2537bd0b9190a1ea8cb72e3bbacaa4db5ebb329ed
APPWRITE_DATABASE_ID=main_db

# ── Sucursal donde corre este agente ────────────────────────
# Obtener el $id del documento en printing_locations
LOCATION_ID=

# ── Impresoras del local (nombre exacto como aparece en Windows) ──
# Ejecutar: Get-Printer | Select-Object Name
PRINTER_BN=
PRINTER_COLOR=
PRINTER_FOTO=

# ── Comportamiento ───────────────────────────────────────────
# Cada cuántos segundos verificar nuevas órdenes
POLL_INTERVAL_SECONDS=10

# Número de copias por defecto si la orden no especifica
DEFAULT_COPIES=1

# Carpeta temporal (se limpia sola después de imprimir)
TEMP_DIR=C:\Windows\Temp\tecnoprint
