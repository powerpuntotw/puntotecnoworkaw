{
  "name": "tecnoprint-agent",
  "version": "1.0.0",
  "description": "Agente de impresion silenciosa para Punto Tecnowork",
  "main": "src/index.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/index.js",
    "install-service": "node src/service-install.js",
    "uninstall-service": "node src/service-uninstall.js",
    "build": "pkg src/index.js --targets node18-win-x64 --output dist/tecnoprint-agent.exe --assets SumatraPDF.exe"
  },
  "dependencies": {
    "node-appwrite": "^14.0.0",
    "axios": "^1.6.0",
    "dotenv": "^16.3.0",
    "node-windows": "^1.0.0-beta.8",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "pkg": "^5.8.1"
  },
  "pkg": {
    "assets": ["SumatraPDF.exe", ".env"],
    "targets": ["node18-win-x64"]
  }
}
